# PolicyIQ environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# Database
POSTGRES_DB=policyiq
POSTGRES_USER=policyiq_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# LLM Backend: ollama | anthropic
LLM_BACKEND=ollama
ANTHROPIC_API_KEY=